@startuml Staff_UseCase
!theme plain
top to bottom direction

' ============================================
' STAFF USE CASE DIAGRAM
' AbodaFarm - Staff Operations Module
' ============================================

skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam actorStyle awesome
skinparam usecaseStyle ellipse
skinparam packagePadding 5
skinparam boxPadding 5

' === ACTORS ===
left to right direction

actor "Staf" as Staf
actor "Admin" as Admin
actor "Peternak\n(Farmer)" as Peternak
actor "Pelanggan\n(Customer)" as Pelanggan
actor "Sistem FCM\n(Notifications)" as FCM
actor "Driver" as Driver

' === SYSTEM BOUNDARY ===
rectangle "AbodaFarm - Staff Operations Module" {

    ' --- Order Management ---
    package "Order Management\n(Manajemen Pesanan)" #LightYellow {
        usecase "UC-51\nDaftar Pesanan" as UC51
        usecase "Lihat Detail Pesanan" as ViewOrderDetail
        usecase "Filter Pesanan\n(Filter Orders)" as FilterOrder
        usecase "Search Pesanan\n(Search Orders)" as SearchOrder
        usecase "Print Invoice" as PrintInvoice
    }

    ' --- Delivery Management ---
    package "Delivery Management\n(Manajemen Pengiriman)" #LightGreen {
        usecase "UC-52\nKelola Pengiriman" as UC52
        usecase "UC-53\nAssign Driver" as UC53
        usecase "Pilih Driver" as SelectDriver
        usecase "Atur Rute\n(Set Route)" as SetRoute
        usecase "UC-54\nUpdate Status Kirim" as UC54
        usecase "Status Persiapan\n(Preparing)" as StatusPrep
        usecase "Status Siap Kirim\n(Ready to Ship)" as StatusReady
        usecase "Status Dalam Pengiriman\n(Out for Delivery)" as StatusShip
        usecase "Status Diterima\n(Delivered)" as StatusDeliv
    }

    ' --- Delivery Proof ---
    package "Delivery Proof\n(Bukti Pengiriman)" #LightCyan {
        usecase "UC-55\nInput Bukti Kirim" as UC55
        usecase "Upload Foto Barang" as UploadPhoto
        usecase "Input Tanda Tangan\n(Receiver Signature)" as SignReceipt
        usecase "Input GPS Location" as GPSLoc
        usecase "Catat Penerima\n(Record Receiver)" as RecordReceiver
        usecase "Catat Kondisi Barang\n(Record Condition)" as RecordCondition
    }

    ' --- Delivery Tracking ---
    package "Delivery Tracking\n(Lacak Pengiriman)" #LightPink {
        usecase "Lacak Pengiriman\n(Track Delivery)" as TrackDelivery
        usecase "Lihat Timeline" as ViewTimeline
        usecase "Update Lokasi\n(Update Location)" as UpdateLocation
        usecase "Laporkan Masalah\n(Report Issue)" as ReportIssue
    }

    ' --- History & Reports ---
    package "History & Reports\n(Riwayat & Laporan)" #Lavender {
        usecase "UC-56\nRiwayat Pengiriman" as UC56
        usecase "Filter Riwayat\n(Filter History)" as FilterHistory
        usecase "Export Laporan\n(Export Report)" as ExportReport
        usecase "Statistik Harian\n(Daily Stats)" as DailyStats
    }

    ' --- Operations ---
    package "Operations\n(Operasional)" #MistyRose {
        usecase "UC-57\nKelola Operasional" as UC57
        usecase "Kelola Armada\n(Manage Fleet)" as ManageFleet
        usecase "Kelola Jadwal\n(Manage Schedule)" as ManageSchedule
        usecase "Kelola Area\n(Manage Area)" as ManageArea
        usecase "Kelola Driver" as ManageDriver
    }

    ' --- Notifications ---
    package "Notifications\n(Notifikasi)" #HoneyDew {
        usecase "UC-58\nNotifikasi" as UC58
        usecase "Pesanan Baru\n(Order Assigned)" as OrderAssigned
        usecase "Update Status\n(Status Update)" as StatusUpdate
        usecase "Pengiriman Selesai\n(Delivery Complete)" as DelivComplete
    }

}

