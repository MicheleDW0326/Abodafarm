        --
        * type : varchar(50)
        * title : varchar(255)
        * message : text
        * data : json
        * is_read : boolean
        * read_at : timestamp
        * created_at : timestamp
    }

    entity "peternak_notifications" as peternak_notifications {
        * id : bigint PK
        --
        * user_id : bigint FK
        --
        * type : varchar(50)
        * title : varchar(255)
        * message : text
        * data : json
        * is_read : boolean
        * read_at : timestamp
        * created_at : timestamp
    }

    entity "staff_notifications" as staff_notifications {
        * id : bigint PK
        --
        * user_id : bigint FK
        --
        * type : varchar(50)
        * title : varchar(255)
        * message : text
        * data : json
        * is_read : boolean
        * read_at : timestamp
        * created_at : timestamp
    }
}

package "WISHLIST & FAVORITES" {
    entity "favorites" as favorites {
        * id : bigint PK
        --
        * user_id : bigint FK
        * favoritable_type : varchar(255)
        * favoritable_id : bigint
        --
        * created_at : timestamp
        * updated_at : timestamp
    }
}

package "CONTENT MANAGEMENT" {
    entity "hero_slides" as hero_slides {
        * id : bigint PK
        --
        * title : varchar(255)
        * subtitle : text
        * image : varchar(255)
        * button_text : varchar(100)
        * button_url : varchar(255)
        * is_active : boolean
        * sort_order : integer
        * starts_at : timestamp
        * ends_at : timestamp
        * created_at : timestamp
        * updated_at : timestamp
    }

    entity "testimonials" as testimonials {
        * id : bigint PK
        --
        * user_id : bigint FK (nullable)
        * name : varchar(255)
        * location : varchar(255)
        * content : text
        * rating : integer
        * image : varchar(255)
        * is_active : boolean
        * created_at : timestamp
        * updated_at : timestamp
    }

    entity "faqs" as faqs {
        * id : bigint PK
        --
        * question : text
        * answer : text
        * category : varchar(50)
        * sort_order : integer
        * is_active : boolean
        * created_at : timestamp
        * updated_at : timestamp
    }

    entity "farm_statistics" as farm_statistics {
        * id : bigint PK
        --
        * user_id : bigint FK
        --
        * period : varchar(20)
        * total_revenue : decimal(14,2)
        * total_orders : integer
        * total_products_sold : integer
        * avg_order_value : decimal(12,2)
        * period_start : date
        * period_end : date
        * created_at : timestamp
        * updated_at : timestamp
    }
}

' ============================================================
' RELATIONSHIPS
' ============================================================

' Users & Authentication
users ||--o{ roles : has_role
users ||--o| customer_levels : belongs_to
users ||--o{ fcm_tokens : has

' Users & Products (Owner relationship)
users ||--o{ products : owns
users ||--o{ farm_profiles : has

' Categories & Products
categories ||--o{ products : contains

' Products & Related
products ||--o{ inventory_logs : has
products ||--o{ care_records : has
products ||--o{ product_views : has
products ||--o{ favorites : has

' Orders & Related
users ||--o{ orders : places
orders ||--o{ order_items : contains
order_items }o--|| products : references
orders ||--o| payments : has
orders ||--|| order_statuses : references_payment
orders ||--|| booking_statuses : references_booking
orders ||--|| shipment_statuses : references_shipment
orders ||--o{ order_status_logs : has
orders ||--o| deliveries : has

' Deliveries & Related
deliveries ||--o{ delivery_timelines : has
deliveries }o--|| users : assigned_staff

' Reviews & Related
users ||--o{ reviews : writes
orders ||--o{ reviews : generates
products ||--o{ reviews : receives
users ||--o{ reviews : for_farmer
reviews ||--o{ review_photos : has
reviews ||--o{ review_videos : has
reviews ||--o{ review_likes : has
reviews ||--o{ review_reports : has

' Farm Profiles & Related
farm_profiles ||--o{ farm_galleries : has
farm_profiles ||--o{ farmer_badges : has
users ||--o{ farmer_followers : followed_by
users ||--o{ farmer_followers : follows

' Addresses
users ||--o{ addresses : has

' Promotions
users ||--o{ promotion_usages : uses
promotions ||--o{ promotion_usages : tracked
orders ||--o{ promotion_usages : applied
marketing_campaigns ||--o{ campaign_rules : has

' Notifications
users ||--o{ customer_notifications : receives
users ||--o{ peternak_notifications : receives
users ||--o{ staff_notifications : receives

' Content
users ||--o{ testimonials : writes
users ||--o{ farm_statistics : has

@enduml
