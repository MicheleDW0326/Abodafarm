@startuml Customer_UseCase
!theme plain
top to bottom direction

' ============================================
' CUSTOMER USE CASE DIAGRAM
' AbodaFarm - Pelanggan Module
' ============================================

skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam actorStyle awesome
skinparam usecaseStyle ellipse

' === ACTORS ===
left to right direction

actor "Guest\n(Tamu)" as Guest
actor "Pelanggan\n(Customer)" as Pelanggan
actor "Sistem Midtrans\n(Payment Gateway)" as Midtrans
actor "Sistem FCM\n(Notifications)" as FCM

' === SYSTEM BOUNDARY ===
rectangle "AbodaFarm - Customer Module" {

    ' --- Catalog & Browsing ---
    package "Catalog & Browsing\n(Katalog Produk)" #LightYellow {
        usecase "UC-03\nLihat Katalog" as UC03
        usecase "UC-04\nSearch Produk" as UC04
        usecase "UC-05\nFilter Produk" as UC05
        usecase "UC-06\nDetail Produk" as UC06
        usecase "Lihat Review\n(View Reviews)" as ViewReview
    }

    ' --- Shopping Cart ---
    package "Shopping Cart\n(Keranjang)" #LightGreen {
        usecase "UC-07\nTambah ke Keranjang" as UC07
        usecase "Lihat Keranjang" as ViewCart
        usecase "Update Jumlah\n(Update Quantity)" as UpdateQty
        usecase "Hapus Item\n(Remove Item)" as RemoveItem
        usecase "Kosongkan Keranjang\n(Clear Cart)" as ClearCart
    }

    ' --- Checkout Process ---
    package "Checkout\n(Pembayaran)" #LightCyan {
        usecase "UC-08\nCheckout" as UC08
        usecase "UC-16\nKelola Alamat" as UC16
        usecase "Tambah Alamat" as AddAddr
        usecase "Pilih Alamat\n(Select Address)" as SelectAddr
        usecase "Tambah Catatan\n(Add Notes)" as AddNotes
        usecase "Hitung Ulang\n(Recalculate)" as Recalculate
    }

    ' --- Payment ---
    package "Payment\n(Pembayaran)" #LightPink {
        usecase "UC-09\nPembayaran" as UC09
        usecase "Pilih Metode Bayar\n(Select Payment Method)" as SelectPay
        usecase "Konfirmasi Bayar\n(Confirm Payment)" as ConfirmPay
        usecase "UC-18\nGunakan Kode Promo" as UC18
        usecase "Lihat Ringkasan\n(View Summary)" as ViewSummary
    }

    ' --- Booking (Inquiry) for Live Animals ---
    package "Booking/Inquiry\n(Booking Ternak)" #Lavender {
        usecase "UC-10\nBuat Booking" as UC10
        usecase "Pilih Jadwal\n(Select Schedule)" as SelectSchedule
        usecase "Upload Dokumen\n(Upload Documents)" as UploadDoc
        usecase "UC-11\nSetujui/Tolak Booking" as UC11
        usecase "Negosiasi Harga\n(Price Negotiation)" as Negotiate
    }

    ' --- Order Tracking ---
    package "Order Tracking\n(Lacak Pesanan)" #MistyRose {
        usecase "UC-12\nLacak Pesanan" as UC12
        usecase "UC-20\nLihat Notifikasi" as UC20
        usecase "UC-13\nKonfirmasi Penerimaan" as UC13
        usecase "UC-22\nRiwayat Pesanan" as UC22
        usecase "Batalkan Pesanan\n(Cancel Order)" as CancelOrder
    }

    ' --- Customer Features ---
    package "Customer Features\n(Fitur Pelanggan)" #HoneyDew {
        usecase "UC-14\nReview Produk" as UC14
        usecase "UC-15\nReview Peternak" as UC15
        usecase "UC-17\nWishlist/Favorit" as UC17
        usecase "UC-19\nKlaim Voucher" as UC19
        usecase "UC-21\nKelola Profil" as UC21
        usecase "UC-23\nWallet & Poin" as UC23
    }

}

' === RELATIONSHIPS ===

' Guest - Browse Only
Guest --> UC03
