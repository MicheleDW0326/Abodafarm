@startuml Admin_UseCase
!theme plain
top to bottom direction

' ============================================
' ADMIN USE CASE DIAGRAM
' AbodaFarm - Administrator Module
' ============================================

skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam actorStyle awesome
skinparam usecaseStyle ellipse

' === ACTORS ===
left to right direction

actor "Admin" as Admin
actor "Staf" as Staf
actor "Peternak\n(Farmer)" as Peternak
actor "Pelanggan\n(Customer)" as Pelanggan

' === SYSTEM BOUNDARY ===
rectangle "AbodaFarm - Admin Module" {

    ' --- Product Management ---
    package "Product Management\n(Manajemen Produk)" #LightYellow {
        usecase "UC-61\nKelola Produk" as UC61
        usecase "Tambah Produk" as AddProduct
        usecase "Edit Produk" as EditProduct
        usecase "Hapus Produk" as DeleteProduct
        usecase "UC-62\nImport Excel" as UC62
        usecase "Export Produk\n(Export Products)" as ExportProduct
        usecase "UC-63\nKelola Kategori" as UC63
        usecase "Tambah Kategori" as AddCategory
        usecase "Edit Kategori" as EditCategory
        usecase "Hapus Kategori" as DeleteCategory
    }

    ' --- Order Management ---
    package "Order Management\n(Manajemen Pesanan)" #LightGreen {
        usecase "UC-64\nKelola Pesanan" as UC64
        usecase "Lihat Semua Pesanan" as ViewAllOrders
        usecase "Filter Pesanan\n(Filter Orders)" as FilterOrders
        usecase "Detail Pesanan" as OrderDetail
        usecase "Batalkan Pesanan\n(Cancel Order)" as CancelOrder
        usecase "Assign Staff" as AssignStaff
        usecase "Edit Pesanan\n(Edit Order)" as EditOrder
    }

    ' --- User Management ---
    package "User Management\n(Manajemen User)" #LightCyan {
        usecase "UC-65\nKelola Pelanggan" as UC65
        usecase "Lihat Pelanggan" as ViewCustomers
        usecase "Edit Pelanggan" as EditCustomer
        usecase "Hapus Pelanggan\n(Delete Customer)" as DeleteCustomer
        usecase "UC-66\nKelola Staf" as UC66
        usecase "Tambah Staf" as AddStaff
        usecase "Edit Staf" as EditStaff
        usecase "Hapus Staf" as DeleteStaff
        usecase "Assign Role" as AssignRole
    }

    ' --- Farmer Management ---
    package "Farmer Management\n(Manajemen Peternak)" #LightPink {
        usecase "UC-70\nVerifikasi Peternak" as UC70
        usecase "Lihat Detail Farm" as ViewFarmDetail
        usecase "Approve Farm" as ApproveFarm
        usecase "Reject Farm" as RejectFarm
        usecase "Suspend Farm" as SuspendFarm
        usecase "Lihat Riwayat Farm" as FarmHistory
    }

    ' --- Marketing ---
    package "Marketing\n(Pemasaran)" #Lavender {
        usecase "UC-67\nKelola Promo" as UC67
        usecase "Buat Kode Promo" as CreatePromo
        usecase "Edit Promo" as EditPromo
        usecase "Hapus Promo\n(Delete Promo)" as DeletePromo
        usecase "UC-68\nKelola Kampanye" as UC68
        usecase "Buat Kampanye" as CreateCampaign
        usecase "Pause/Resume Kampanye" as PauseCampaign
        usecase "Kelola Voucher" as ManageVoucher
        usecase "Statistik Kampanye\n(Campaign Stats)" as CampaignStats
    }

    ' --- Content Management ---
    package "Content Management\n(Manajemen Konten)" #MistyRose {
        usecase "UC-76\nKelola Konten" as UC76
        usecase "Kelola FAQ" as ManageFAQ
        usecase "Kelola Testimonial" as ManageTesti
        usecase "Kelola Hero Slide" as ManageHero
        usecase "Kelola Statistik\n(Manage Stats)" as ManageStats
        usecase "Kelola Artikel\n(Manage Articles)" as ManageArticles
    }

    ' --- Reviews & Moderation ---
    package "Reviews & Moderation\n(Moderasi Ulasan)" #HoneyDew {
        usecase "UC-69\nModerasi Review" as UC69
        usecase "Approve Review" as ApproveReview
        usecase "Reject Review" as RejectReview
        usecase "Hapus Review" as DeleteReview
        usecase "Lihat Laporan\n(View Reports)" as ViewReports
        usecase "Blokir User\n(Block User)" as BlockUser
    }

    ' --- Reports & Analytics ---
    package "Reports & Analytics\n(Laporan & Analitik)" #LightGray {
        usecase "UC-71\nLaporan Keuangan" as UC71
        usecase "Revenue Report" as RevenueReport
        usecase "Profit Report" as ProfitReport
        usecase "UC-72\nDashboard Analitik" as UC72
        usecase "Sales Analytics" as SalesAnalytics
        usecase "User Analytics" as UserAnalytics
        usecase "Product Analytics" as ProductAnalytics
        usecase "UC-73\nExport Laporan" as UC73
    }

    ' --- Settings ---
    package "Settings\n(Pengaturan)" #LightBlue {
        usecase "UC-74\nPengaturan Toko" as UC74
        usecase "Pengaturan Umum\n(General Settings)" as GenSettings
        usecase "Pengaturan Logo" as LogoSettings
        usecase "Pengaturan Contact" as ContactSettings
        usecase "Pengaturan Payment" as PaymentSettings
        usecase "UC-75\nArea Pengiriman" as UC75
        usecase "Tambah Area" as AddArea
        usecase "Edit Biaya Ongkir\n(Edit Shipping Fee)" as EditFee
        usecase "Hapus Area\n(Delete Area)" as DeleteArea
    }

}

