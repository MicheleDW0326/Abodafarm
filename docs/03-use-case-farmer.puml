@startuml Farmer_UseCase
!theme plain
top to bottom direction

' ============================================
' FARMER USE CASE DIAGRAM
' AbodaFarm - Peternak Module
' ============================================

skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam actorStyle awesome
skinparam usecaseStyle ellipse

' === ACTORS ===
left to right direction

actor "Peternak\n(Farmer)" as Peternak
actor "Admin" as Admin
actor "Pelanggan\n(Customer)" as Pelanggan
actor "Sistem FCM\n(Notifications)" as FCM

' === SYSTEM BOUNDARY ===
rectangle "AbodaFarm - Peternak Module" {

    ' --- Product Management ---
    package "Product Management\n(Manajemen Produk)" #LightYellow {
        usecase "UC-31\nDashboard Produk" as UC31
        usecase "UC-32\nTambah Produk" as UC32
        usecase "UC-33\nEdit Produk" as UC33
        usecase "UC-34\nHapus Produk" as UC34
        usecase "UC-35\nKelola Stok" as UC35
        usecase "Update Stok" as UpdateStock
        usecase "Riwayat Stok\n(Stock History)" as InvHistory
    }

    ' --- Livestock Management ---
    package "Livestock Management\n(Manajemen Ternak)" #LightGreen {
        usecase "UC-47\nKelola Care Records" as UC47
        usecase "Catat Feeding" as RecordFeeding
        usecase "Catat Vaccination" as RecordVaccine
        usecase "Catat Health Check" as RecordHealth
        usecase "Catat Cleaning" as RecordCleaning
        usecase "Lihat Riwayat Care" as ViewCareHistory
    }

    ' --- Booking Management ---
    package "Booking Management\n(Manajemen Booking)" #LightCyan {
        usecase "UC-36\nBooking Masuk" as UC36
        usecase "Lihat Detail Booking" as ViewBooking
        usecase "UC-37\nSetujui/Tolak" as UC37
        usecase "Jadwalkan Survei\n(Schedule Survey)" as ScheduleSurvey
        usecase "Negosiasi Harga" as Negotiate
        usecase " Kirim Penawaran\n(Send Offer)" as SendOffer
    }

    ' --- Order Management ---
    package "Order Management\n(Manajemen Pesanan)" #LightPink {
        usecase "UC-38\nKelola Pesanan" as UC38
        usecase "UC-39\nUpdate Status Kirim" as UC39
        usecase "Input Info Kirim\n(Shipping Info)" as ShipInfo
        usecase "Lacak Pengiriman\n(Track Delivery)" as TrackShipment
        usecase "Generate Dokumen\n(Generate Docs)" as GenerateDocs
    }

    ' --- Farm Profile ---
    package "Farm Profile\n(Profil Peternakan)" #Lavender {
        usecase "UC-40\nProfil Peternakan" as UC40
        usecase "Edit Info Farm" as EditFarm
        usecase "UC-45\nKelola Galeri" as UC45
        usecase "Upload Foto" as UploadPhoto
        usecase "Hapus Foto" as DeletePhoto
        usecase "Atur Lokasi GPS" as SetLocation
        usecase "Kelola Badge" as ManageBadge
    }

    ' --- Reviews & Ratings ---
    package "Reviews & Ratings\n(Ulasan & Rating)" #MistyRose {
        usecase "UC-43\nLihat Ulasan" as UC43
        usecase "UC-44\nBalas Ulasan" as UC44
        usecase "Lihat Rating\n(View Rating)" as ViewRating
        usecase "Statistik Ulasan\n(Review Stats)" as ReviewStats
    }

    ' --- Analytics & Reports ---
    package "Analytics & Reports\n(Analitik & Laporan)" #HoneyDew {
        usecase "UC-41\nDashboard Analitik" as UC41
        usecase "UC-42\nExport Laporan" as UC42
        usecase "Lihat Revenue" as ViewRevenue
        usecase "Lihat Statistik" as ViewStats
        usecase "Trend Penjualan\n(Sales Trend)" as SalesTrend
    }

    ' --- Notifications ---
    package "Notifications\n(Notifikasi)" #LightGray {
        usecase "UC-46\nNotifikasi" as UC46
        usecase "Booking Baru\n(New Booking Alert)" as NewBooking
        usecase "Ulasan Baru\n(New Review Alert)" as NewReview
        usecase "Pembayaran\n(Payment Alert)" as PaymentAlert
    }

}

